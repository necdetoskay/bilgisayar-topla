{
  "name": "@bilgisayar-topla/specification-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "specification-harness": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm --filter @bilgisayar-topla/product-extractor run build && tsc -p tsconfig.json",
    "run": "pnpm run build && node dist/cli.js",
    "test": "pnpm run build && node --test dist/**/*.test.js",
    "typecheck": "pnpm --filter @bilgisayar-topla/product-extractor run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bilgisayar-topla/product-extractor": "workspace:*",
    "@bilgisayar-topla/shared-contracts": "workspace:*",
    "@bilgisayar-topla/specification": "workspace:*"
  }
}
